# 参数清单，不含真实密码。Spring Boot 不会自动加载此文件。
# 在 PowerShell 的 $env:、IDE Run Configuration 或容器环境中设置。
SPRING_PROFILES_ACTIVE=dev
NACOS_ADDR=192.168.100.129:8848
# 使用命名空间 ID；若 wanjoyMall 只是显示名称，请替换为实际 ID。
NACOS_NAMESPACE=wanjoyMall
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=

WM_DB_HOST=127.0.0.1
WM_DB_PORT=3306
WM_DB_USER=wanjoymall
WM_DB_PASSWORD=
# WM_DB_NAME 不要统一设置：各服务默认使用自己的已有 hm-* 业务库；wm 配置前缀不变。

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=wanjoymall
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/wanjoymall

SEATA_ENABLED=true
# Seata 从 Nacos 查找 seata-server；不再使用 SEATA_SERVER 直连地址。
# TC 注册命名空间由 seata.registry.nacos.namespace 单独配置，默认 public。
SENTINEL_DASHBOARD=127.0.0.1:8090
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 下列为仓库内开发密钥的公开配置，仅限开发。生产环境必须使用外部密钥库。
WM_JWT_LOCATION=classpath:wanjoymall.jks
WM_JWT_ALIAS=wanjoymall
WM_JWT_PASSWORD=wanjoymall-dev-key

# 专用集成测试环境；只有显式允许写入时才会运行集成测试。
WM_TEST_DB_HOST=127.0.0.1
WM_TEST_REDIS_HOST=127.0.0.1
WM_TEST_REDIS_PORT=6379
WM_TEST_REDIS_PASSWORD=
WM_TEST_ES_HOST=127.0.0.1
WM_TEST_ES_PORT=9200
